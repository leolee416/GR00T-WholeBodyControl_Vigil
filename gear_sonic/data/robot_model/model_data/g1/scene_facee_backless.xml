<mujoco model="g1_43dof FaceE backless-chair scene">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0.8 0 0.5" extent="2.5"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="10 10" reflectance="0.15"/>
    <mesh name="facee_backless_41cm_proxy" file="facee_backless_41cm_proxy.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      contype="2" conaffinity="1" friction="1.0 0.005 0.0001"/>
    <!--
      E0019 uses a uniform, backless 0.50 x 0.45 m collision proxy from the
      floor to a 0.41 m top.  The body starts below the floor and is placed
      from the exact-v3 catalog before the first mj_forward call.
    -->
    <body name="facee_chair" pos="0 0 -2">
      <geom name="facee_chair_collision" type="mesh"
        mesh="facee_backless_41cm_proxy" density="0" contype="2" conaffinity="1"
        friction="1.0 0.005 0.0001" rgba="0.92 0.72 0.12 1"/>
    </body>
    <site name="com_marker" pos="0.1 0 0" size="0.025" rgba="1 0 0 1"
      type="sphere"/>
  </worldbody>
</mujoco>
